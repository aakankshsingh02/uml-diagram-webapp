NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Matches the defaults in ../docker-compose.yml
DATABASE_URL=postgres://uml:uml_password@localhost:5432/uml_diagrams

# Kroki gateway (PlantUML built in, Mermaid + Excalidraw via companion containers)
KROKI_URL=http://localhost:8000

# https://console.groq.com/keys
GROQ_API_KEY= 
GROQ_MODEL=openai/gpt-oss-120b

# Bearer token the ART trainer uses for /api/training/* (generate a long random value)
TRAINING_API_TOKEN=

# How long a login session stays valid
SESSION_TTL_DAYS=30

# Optional: database for `npm test`. Export it in your shell (vitest does not read .env).
# The name must end in _test because tests truncate it.
# TEST_DATABASE_URL=postgres://uml:uml_password@localhost:5432/uml_diagrams_test
WANDB_API_KEY=