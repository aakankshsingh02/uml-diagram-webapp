{
  "name": "uml-diagram-backend",
  "version": "1.0.0",
  "description": "Chat-based UML generator API (controller-service-repository)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
