# Backend trajectory export (must match backend/.env TRAINING_API_TOKEN)
API_URL=http://localhost:4000/api
TRAINING_API_TOKEN=

# Kroki (render-rate reward)
KROKI_URL=http://localhost:8000

# ART serverless training (W&B): https://wandb.ai/authorize
WANDB_API_KEY=

# RULER judge via LiteLLM (default uses Groq)
GROQ_API_KEY=
RULER_JUDGE_MODEL=groq/openai/gpt-oss-120b

# Trainable model
ART_PROJECT=uml-diagrams
ART_MODEL_NAME=uml-diagrammer
ART_RUN_NAME=main
ART_BASE_MODEL=OpenPipe/Qwen3-14B-Instruct
